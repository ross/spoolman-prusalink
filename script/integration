#!/usr/bin/env bash
# Run the end-to-end tests in integration/ against a real Spoolman.
#
# Each run starts its own throwaway Spoolman container with Podman or Docker on a
# free local port, points the tests at it with INTEGRATION_SPOOLMAN_URL, and
# removes it afterwards. Two runs never share a Spoolman: a bridge flags claimed
# spools outside its own tool locations, so runs on one Spoolman break each
# other's tests (see integration/README.md). Arguments go to pytest:
#
#   script/integration -k runout
#
# SPOOLMAN_IMAGE picks the image (default in script/lib/spoolman.sh) and
# CONTAINER_ENGINE picks podman or docker (default: podman if it's installed).
set -euo pipefail
cd "$(dirname "$0")/.."

if [ -n "${INTEGRATION_SPOOLMAN_URL:-}" ]; then
    echo "==> INTEGRATION_SPOOLMAN_URL is set; unset it. Each run starts its own Spoolman." >&2
    exit 1
fi

[ -n "${SKIP_BOOTSTRAP:-}" ] || script/bootstrap
# shellcheck source=script/lib/spoolman.sh
source script/lib/spoolman.sh

image=$spoolman_image
engine=$container_engine
port=$(.venv/bin/python -c 'import socket; s = socket.socket(); s.bind(("127.0.0.1", 0)); print(s.getsockname()[1])')

echo "==> Starting $image with $engine on 127.0.0.1:$port"
container=$("$engine" run -d --rm -p "127.0.0.1:$port:8000" "$image")
trap '"$engine" rm -f "$container" >/dev/null' EXIT

export INTEGRATION_SPOOLMAN_URL=http://127.0.0.1:$port
echo "==> Waiting for Spoolman"
wait_for "$INTEGRATION_SPOOLMAN_URL/api/v1/health" Spoolman

echo "==> Running the integration tests against $INTEGRATION_SPOOLMAN_URL"
.venv/bin/pytest integration "$@"
