#!/usr/bin/env bash
# Pin every dependency with proviso: requirements.txt holds the bridge's own
# dependencies, for the image; requirements-dev.txt adds every extra, for
# script/bootstrap. Run it after changing dependencies in pyproject.toml, or
# to pick up new releases. Arguments go to proviso, for example
# `script/update-requirements --level INFO`.
#
# proviso skips releases less than 7 days old (--cooldown-days), so a version
# from this week won't be picked yet.
set -euo pipefail
cd "$(dirname "$0")/.."

[ -n "${SKIP_BOOTSTRAP:-}" ] || script/bootstrap

header="# DO NOT EDIT THIS FILE DIRECTLY - use script/update-requirements"

echo "==> Pinning requirements.txt"
.venv/bin/proviso --extras '' --header "$header" "$@"
echo "==> Pinning requirements-dev.txt"
.venv/bin/proviso --filename requirements-dev.txt --header "$header" "$@"

script/bootstrap
