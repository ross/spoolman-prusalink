#!/usr/bin/env bash
# Check that the firmware files the hand-copied preset tables come from haven't changed.
#
# docs/firmware-pin.txt lists each file with its git blob hash. This compares those
# hashes with the firmware's and exits 1 if any file changed or is missing, 0 if all
# match, 2 on a usage error. Any other status is git's: it couldn't fetch or read the
# ref, or DIR isn't a repository.
#
#   script/firmware-check                    # upstream master
#   script/firmware-check REF                # an upstream branch, tag or full commit hash
#   script/firmware-check --checkout DIR [REF]   # a local checkout, at REF (default HEAD)
#
# Upstream mode fetches from GitHub without the API or a token, and can't fetch a
# commit by a short hash. Needs git.
set -euo pipefail

usage() {
    echo "usage: script/firmware-check [REF | --checkout DIR [REF]]" >&2
    exit 2
}

checkout=""
ref=""
if [ "${1:-}" = "--checkout" ]; then
    [ $# -ge 2 ] && [ $# -le 3 ] || usage
    # Resolve DIR from the caller's directory, before the cd below.
    checkout=$(cd "$2" && pwd) || usage
    ref=${3:-HEAD}
else
    [ $# -le 1 ] || usage
    ref=${1:-master}
    case $ref in -*) usage ;; esac
fi

cd "$(dirname "$0")/.."
pin=docs/firmware-pin.txt

repo=$(awk '$1 == "repo" { print $2 }' "$pin")
[ -n "$repo" ] || { echo "no repo line in $pin" >&2; exit 2; }
# Lines of "<blob> <path>", without comments.
entries=$(sed -e 's/#.*//' "$pin" | awk 'NF == 2 && $1 != "repo" && $1 != "commit"')
[ -n "$entries" ] || { echo "no files in $pin" >&2; exit 2; }

if [ -n "$checkout" ]; then
    treeish=$ref
    dir=$checkout
else
    tmp=$(mktemp -d)
    trap 'rm -rf "$tmp"' EXIT
    git -C "$tmp" init -q
    echo "==> Fetching $ref from github.com/$repo"
    git -C "$tmp" fetch -q --depth 1 --filter=blob:none "https://github.com/$repo.git" "$ref"
    dir=$tmp
    treeish=FETCH_HEAD
fi

paths=$(echo "$entries" | awk '{ print $2 }')
# shellcheck disable=SC2086 # The paths have no spaces.
tree=$(git -C "$dir" ls-tree "$treeish" -- $paths)

status=0
while read -r pinned path; do
    current=$(echo "$tree" | awk -v p="$path" '$4 == p { print $3 }')
    if [ -z "$current" ]; then
        echo "MISSING    $path"
        status=1
    elif [ "$current" != "$pinned" ]; then
        echo "CHANGED    $path"
        status=1
    else
        echo "unchanged  $path"
    fi
done <<<"$entries"

if [ "$status" -ne 0 ]; then
    cat >&2 <<MSG

The firmware changed. Re-read each file marked CHANGED or MISSING, update the copies
that $pin lists for it, then update the hash there and commit it with the copies.
MSG
fi
exit "$status"
